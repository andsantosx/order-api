# ==========================================
# Server Configuration
# ==========================================
PORT=3000
NODE_ENV=example

# ==========================================
# Banco de dados - LOCAL
# ==========================================
DB_HOST=example
DB_PORT=5432
DB_NAME=your_database_here
DB_USER=postgres
DB_PASSWORD=your_password_here

# ==========================================
# Mercado Pago
# ==========================================
MERCADOPAGO_ACCESS_TOKEN=example
MERCADOPAGO_PUBLIC_KEY=example
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret_here
MERCADOPAGO_WEBHOOK_URL=https://example

# ==========================================
# Frontend
# ==========================================
# URL do frontend para CORS (SEM barra final!)
FRONTEND_URL=example

# ==========================================
# JWT Security
# ==========================================
JWT_SECRET=your_secure_jwt_secret_minimum_32_characters_long_here

# ==========================================
# Google reCAPTCHA
# ==========================================
RECAPTCHA_SECRET_KEY=sua_chave_secreta_aqui

# ==========================================
# Logging
# ==========================================
# Níveis: error, warn, info, debug
# Produção: info ou warn
# Desenvolvimento: debug
LOG_LEVEL=debug

# ==========================================
# Rate Limiting
# ==========================================
# IMPORTANTE: Valores abaixo são DEFAULTS se não configurados
# Configure valores mais permissivos para DEV, restritivos para PROD

# General API (todas as rotas)
# Dev: 500 req/15min | Prod: 100 req/15min
RATE_LIMIT_GENERAL_WINDOW=900000    # 15 minutos (em ms)
RATE_LIMIT_GENERAL_MAX=100          # Max requests

# Authentication (login/register)
# Dev: 50 req/15min | Prod: 5 req/15min (estrito!)
RATE_LIMIT_AUTH_WINDOW=900000       # 15 minutos (em ms)
RATE_LIMIT_AUTH_MAX=5               # Max requests (previne brute force)

# Order creation
# Dev: 100 req/1h | Prod: 10 req/1h
RATE_LIMIT_ORDER_WINDOW=3600000     # 1 hora (em ms)
RATE_LIMIT_ORDER_MAX=10             # Max pedidos por janela

# Payment processing
# Dev: 50 req/15min | Prod: 5 req/15min
RATE_LIMIT_PAYMENT_WINDOW=900000    # 15 minutos (em ms)
RATE_LIMIT_PAYMENT_MAX=5            # Max tentativas de pagamento

# ==========================================
# Order Automation
# ==========================================
# Tempo para expirar pedidos Pendentes/Processando (em horas)
ORDER_EXPIRATION_HOURS=24
# Intervalo de verificação da rotina (Cron expression - padrão: a cada 30 min)
ORDER_EXPIRATION_CRON="0 */30 * * * *"

# ==========================================
# Mailjet Configuration
# ==========================================
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_SENDER_EMAIL=
MAILJET_SENDER_NAME=
