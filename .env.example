# ==========================================
# Server Configuration
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Database
# ==========================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/order_db

# ==========================================
# Mercado Pago
# ==========================================
# Obtenha suas credenciais em: https://www.mercadopago.com.br/developers
# TEST-* para ambiente de testes, PROD-* para produção
MERCADOPAGO_ACCESS_TOKEN=TEST-your_access_token_here
MERCADOPAGO_PUBLIC_KEY=TEST-your_public_key_here
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret_here

# ==========================================
# Frontend
# ==========================================
# URL do frontend para CORS (SEM barra final!)
FRONTEND_URL=http://localhost:3000

# ==========================================
# JWT Security
# ==========================================
# Gere um secret forte com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MÍNIMO: 32 caracteres (validado no startup)
# PRODUÇÃO: 64+ caracteres recomendado
JWT_SECRET=your_secure_jwt_secret_minimum_32_characters_long_here

# ==========================================
# Logging
# ==========================================
# Níveis: error, warn, info, debug
# Produção: info ou warn
# Desenvolvimento: debug
LOG_LEVEL=debug

# ==========================================
# Rate Limiting
# ==========================================
# IMPORTANTE: Valores abaixo são DEFAULTS se não configurados
# Configure valores mais permissivos para DEV, restritivos para PROD

# General API (todas as rotas)
# Dev: 500 req/15min | Prod: 100 req/15min
RATE_LIMIT_GENERAL_WINDOW=900000    # 15 minutos (em ms)
RATE_LIMIT_GENERAL_MAX=100          # Max requests

# Authentication (login/register)
# Dev: 50 req/15min | Prod: 5 req/15min (estrito!)
RATE_LIMIT_AUTH_WINDOW=900000       # 15 minutos (em ms)
RATE_LIMIT_AUTH_MAX=5               # Max requests (previne brute force)

# Order creation
# Dev: 100 req/1h | Prod: 10 req/1h
RATE_LIMIT_ORDER_WINDOW=3600000     # 1 hora (em ms)
RATE_LIMIT_ORDER_MAX=10             # Max pedidos por janela

# Payment processing
# Dev: 50 req/15min | Prod: 5 req/15min
RATE_LIMIT_PAYMENT_WINDOW=900000    # 15 minutos (em ms)
RATE_LIMIT_PAYMENT_MAX=5            # Max tentativas de pagamento

# ==========================================
# Production Checklist
# ==========================================
# [ ] NODE_ENV=production
# [ ] JWT_SECRET com 64+ caracteres aleatórios
# [ ] DATABASE_URL com SSL (?sslmode=require)
# [ ] MERCADOPAGO_* com credenciais de produção
# [ ] FRONTEND_URL com domínio de produção (HTTPS)
# [ ] LOG_LEVEL=info ou warn
# [ ] Rate limits mais restritivos (valores Prod acima)
# [ ] Verificar npm audit
# [ ] HTTPS configurado (certificado válido)
# [ ] Backups automáticos do banco
# [ ] Monitoramento de logs (CloudWatch, etc)

