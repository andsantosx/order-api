PORT=exemple
NODE_ENV=exemple
DATABASE_URL=exemple

# Frontend
FRONTEND_URL=http://localhost:3000

# JWT Security
JWT_SECRET=your_very_long_random_secret_here

# Logging
LOG_LEVEL=info

# Mercado Pago Keys
MERCADOPAGO_ACCESS_TOKEN=exemple
MERCADOPAGO_PUBLIC_KEY=exemple
MERCADOPAGO_WEBHOOK_SECRET=exemple

# Rate Limiting (optional - defaults are set in code)
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_AUTH_WINDOW=900000
# RATE_LIMIT_ORDER_MAX=10
# RATE_LIMIT_ORDER_WINDOW=3600000
# RATE_LIMIT_GENERAL_MAX=100
# RATE_LIMIT_GENERAL_WINDOW=900000