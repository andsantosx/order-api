{
  "name": "order-api",
  "version": "1.0.0",
  "description": "API de pedidos simples",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run migration:run:prod && node dist/server.js",
    "dev": "npx ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:test": "concurrently \"npx ts-node-dev --respawn --transpile-only src/server.ts\" \"npm run test:watch\"",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js",
    "migration:create": "npm run typeorm migration:create ./src/migrations/$npm_config_name",
    "migration:generate": "npm run typeorm -- -d ./src/data-source.ts migration:generate ./src/migrations/$npm_config_name",
    "migration:run": "npm run typeorm -- -d ./src/data-source.ts migration:run",
    "migration:run:prod": "typeorm migration:run -d dist/data-source.js",
    "migration:revert": "npm run typeorm -- -d ./src/data-source.ts migration:revert",
    "lint": "npx eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "format": "npx prettier --write \"src/**/*.ts\"",
    "test": "NODE_ENV=test jest --runInBand",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:cov": "NODE_ENV=test jest --coverage --runInBand",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose up -d --build",
    "seed": "ts-node-dev --transpile-only src/tests/seed/seed-test.ts",
    "clean": "rm -rf logs/*.log coverage/ dist/ && echo '✅ Projeto limpo! (logs, coverage e dist removidos)'"
  },
  "keywords": [
    "express",
    "api",
    "orders"
  ],
  "author": "Anderson Santos",
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "json5": "^2.2.3",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "^2.12.0",
    "node-cron": "^4.2.1",
    "node-mailjet": "^6.0.11",
    "pg": "^8.17.2",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.10.0",
    "typeorm": "^0.3.28",
    "typescript": "^5.6.3",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.9",
    "@types/node-cron": "^3.0.11",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "mercadopago": {
      "uuid": "14.0.0"
    },
    "typeorm": {
      "uuid": "14.0.0"
    }
  }
}
